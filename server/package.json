{
  "name": "overbot-server",
  "version": "1.0.0",
  "description": "Twitch bot server using TMI.js",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "get-token": "tsx scripts/get-token.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/tmi.js": "^1.8.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
